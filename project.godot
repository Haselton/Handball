[application]
config/name="Handball"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[admob]

general/android/enabled=true
general/android/app_id="ca-app-pub-3940256099942544~3347511713"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.12, 0.17, 0.22, 1)

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
3d/physics_engine="Jolt Physics"

[input]
strike={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1,"pressed":true)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

[audio]
driver/enable_input=false
